PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
# Optional, local only: set if you get "querySrv ECONNREFUSED" when connecting
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Any long random string, used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# From your GitHub OAuth App (github.com/settings/developers -> OAuth Apps).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must exactly match the "Authorization callback URL" configured on the OAuth App.
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Set to "production" on Render so session cookies are marked Secure (HTTPS-only).
# Render sets this automatically; leave unset locally.
# NODE_ENV=production
